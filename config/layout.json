{
  "app_name": "aion",
  "theme": {
    "accent": "#5ad1ff",
    "ok": "#7CFFB2",
    "warn": "#FFD479",
    "err": "#FF6B6B",
    "dim": "#5a6b7b"
  },
  "workspaces": [
    {"id": "models",  "title": "Models",   "icon": "◈"},
    {"id": "tasks",   "title": "Tasks",    "icon": "▤"},
    {"id": "agent",   "title": "Agent",    "icon": "✦"},
    {"id": "memory",  "title": "Memory",   "icon": "◎"}
  ],
  "deck": {"enabled": true, "port": null},
  "keybindings": {
    "workspace_1": "1", "workspace_2": "2", "workspace_3": "3", "workspace_4": "4",
    "nav_up": ["up", "k"], "nav_down": ["down", "j"],
    "nav_left": ["left", "h"], "nav_right": ["right", "l"],
    "activate": ["enter", "space"], "back": ["escape", "b"],
    "context": ["c"], "palette": "ctrl+k", "voice": "v"
  },
  "harnesses": [
    {"id": "demo",    "type": "demo",    "name": "Demo Harness",   "enabled": true, "vram_mb": 420, "tier": "standard", "max_steps": 20},
    {"id": "shell",   "type": "shell",   "name": "Shell Agent",    "enabled": true, "vram_mb": 0,   "tier": "cheap",    "max_steps": 12, "command": "echo step {n} of {p} && sleep 0.2"},
    {"id": "cyclops", "type": "cyclops", "name": "Cyclops Agent",  "enabled": true, "vram_mb": 1200,"tier": "premium"},
    {"id": "remote",  "type": "remote",  "name": "Remote Kernel",  "enabled": true, "vram_mb": 0,   "tier": "standard", "remote": "localhost:8765"},
    {"id": "telemetry", "type": "telemetry", "name": "Telemetry",   "enabled": true, "vram_mb": 0,   "tier": "standard", "source": "none", "interval": 2.0},
    {"id": "app",     "type": "app",     "name": "App Launcher",   "enabled": true, "vram_mb": 0,   "tier": "cheap",    "command": "{p}"}
  ]
}
