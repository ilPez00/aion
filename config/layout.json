{
  "app_name": "aion",
  "theme": {
    "accent": "#5ad1ff",
    "ok": "#7CFFB2",
    "warn": "#FFD479",
    "err": "#FF6B6B",
    "dim": "#5a6b7b"
  },
  "themes": {
    "jarvis": {
      "accent": "#5ad1ff",
      "ok": "#7CFFB2",
      "warn": "#FFD479",
      "err": "#FF6B6B",
      "dim": "#5a6b7b"
    },
    "matrix": {
      "accent": "#00ff41",
      "ok": "#00ff41",
      "warn": "#ffff00",
      "err": "#ff0000",
      "dim": "#003300"
    },
    "amber": {
      "accent": "#ffb000",
      "ok": "#00ff88",
      "warn": "#ff8800",
      "err": "#ff4444",
      "dim": "#664400"
    }
  },
  "persona": {
    "verbosity": "normal",
    "formality": "casual",
    "voice_enabled": true
  },
  "workspaces": [
    {"id": "desktop",  "title": "Desktop",  "icon": "⬡"},
    {"id": "models",   "title": "Subsystems",   "icon": "◈"},
    {"id": "tasks",    "title": "Tasks",    "icon": "▤"},
    {"id": "agent",    "title": "Agent",    "icon": "✦"},
    {"id": "vault",    "title": "Vault",    "icon": "📓"},
    {"id": "system",   "title": "System",   "icon": "🖥"},
    {"id": "term",     "title": "Term",     "icon": "▣"},
    {"id": "settings", "title": "Settings", "icon": "⚙️"}
  ],
  "deck": {"enabled": true, "port": null},
  "keybindings": {
    "workspace_1": "1", "workspace_2": "2", "workspace_3": "3", "workspace_4": "4",
    "workspace_5": "5", "workspace_6": "6", "workspace_7": "7", "workspace_8": "8",
    "nav_up": ["up", "k"], "nav_down": ["down", "j"],
    "nav_left": ["left", "h"], "nav_right": ["right", "l"],
    "activate": ["enter", "space"], "back": ["escape", "b"],
    "context": ["c"], "palette": "ctrl+k", "voice": "v"
  },
  "harnesses": [
    {"id": "demo",    "type": "demo",    "name": "Demo Harness",   "context_tags": ["system","dev"], "enabled": true, "vram_mb": 420, "tier": "standard", "max_steps": 20},
    {"id": "shell",   "type": "shell",   "name": "Shell Agent",    "context_tags": ["dev"], "enabled": true, "vram_mb": 0,   "tier": "cheap",    "max_steps": 12, "command": "echo step {n} of {p} && sleep 0.2"},
    {"id": "cyclops", "type": "cyclops", "name": "Cyclops Agent",  "context_tags": ["agent"], "enabled": true, "vram_mb": 1200,"tier": "premium"},
    {"id": "remote",  "type": "remote",  "name": "Remote Kernel",  "context_tags": ["system","dev"], "enabled": true, "vram_mb": 0,   "tier": "standard", "remote": "localhost:8765"},
    {"id": "telemetry", "type": "telemetry", "name": "Telemetry",   "context_tags": ["system","desktop"], "enabled": true, "vram_mb": 0,   "tier": "standard", "source": "none", "interval": 2.0},
    {"id": "stats",     "type": "stats",     "name": "Jarvis HUD",   "context_tags": ["desktop","system"], "enabled": true, "vram_mb": 0,   "tier": "standard", "window": "today", "interval": 3.0},
    {"id": "app",     "type": "app",     "name": "App Launcher",   "context_tags": ["desktop"], "enabled": true, "vram_mb": 0,   "tier": "cheap",    "command": "{p}"},
    {"id": "hermes",  "type": "hermes",  "name": "Hermes Agent",   "context_tags": ["agent"], "enabled": true, "vram_mb": 0,   "tier": "premium"},
    {"id": "skill",   "type": "skill",   "name": "Skill Runner",   "context_tags": ["agent"], "enabled": true, "vram_mb": 0,   "tier": "standard"},
    {"id": "projects","type": "projects","name": "Projects",       "context_tags": ["dev"], "enabled": true, "vram_mb": 0,   "tier": "standard", "interval": 8.0, "check_prs": false},
    {"id": "term",    "type": "term",    "name": "Term",          "context_tags": ["dev","system"], "enabled": true, "vram_mb": 0,   "tier": "cheap", "command": "btop", "cols": 110, "rows": 32},
    {"id": "web",     "type": "web",     "name": "DeepSearch",     "context_tags": ["dev","agent"], "enabled": true, "vram_mb": 0,   "tier": "cheap"},
    {"id": "opencode","type": "opencode","name": "OpenCode Agent", "context_tags": ["dev","agent"], "enabled": true, "vram_mb": 0,   "tier": "premium", "extra": {"model": "llm7/codestral-latest", "timeout": 300, "auto": false}},
    {"id": "system",  "type": "system",  "name": "Computer HUD",   "context_tags": ["system","desktop"], "enabled": true, "vram_mb": 0,   "tier": "standard", "interval": 2.0},
    {"id": "health",  "type": "health",  "name": "Life HUD",       "context_tags": ["health","desktop"], "enabled": true, "vram_mb": 0,   "tier": "standard", "source": "json", "interval": 30.0},
    {"id": "vault",   "type": "vault",   "name": "Vault",          "context_tags": ["vault"], "enabled": true, "vram_mb": 0,   "tier": "standard", "interval": 15.0, "prompt_setup": true},
    {"id": "physis",  "type": "physis",  "name": "Coherence Brain", "context_tags": ["system","agent"], "enabled": true, "vram_mb": 0,   "tier": "standard", "extra": {"interval": 5.0}},
    {"id": "agent_entity","type": "agent_entity","name": "Agent Entities","context_tags": ["agent"], "enabled": true, "vram_mb": 0, "tier": "standard", "interval": 3.0},
    {"id": "board",   "type": "board",   "name": "Board",         "context_tags": ["tasks","agent"], "enabled": true, "vram_mb": 0,   "tier": "standard", "interval": 5.0}
  ]
}
